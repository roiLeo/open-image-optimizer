{
  "name": "social-media-image-optimizer",
  "scripts": {
    "dev": "nuxi dev",
    "build": "nuxi build",
    "start": "nuxi start",
    "lint": "eslint --ignore-path .gitignore --ext .js,.ts,.vue .",
    "lint:quiet": "eslint --quiet --ignore-path .gitignore --ext .js,.ts,.vue .",
    "lint:fix": "eslint --fix --quiet --ignore-path .gitignore --ext .js,.ts,.vue ."
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@nuxt/devtools": "3.2.0",
    "@nuxt/eslint-config": "^1.15.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@nuxt/ui": "4.4.0",
    "@nuxtjs/i18n": "^10.2.3",
    "nuxt": "^4.3.1"
  },
  "packageManager": "pnpm@9.15.7"
}
